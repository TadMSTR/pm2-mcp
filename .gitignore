__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
# SC-02: the bare `.env` above missed every other spelling. Core dumps matter here
# specifically — this process holds the environment it is about to hand to the pm2 CLI,
# so a dump of it is a dump of whatever that environment contained.
*.env
!.env.example
# core.[0-9]*, not core.*: the bare form would also ignore a future core.py (SC-02).
core.[0-9]*
*.core
# Key material (repo standard B6). Nothing in this repo needs a key file.
*.key
*.pem
.venv/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
mutants/
.mutmut-cache
dist/
build/
mutmut-results.txt
.audit-runtime/
.audit-dev/
